                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    CAST(GuiaID AS VARCHAR(20)) AS GuiaID,

    CAST(FechaEnvio AS DATE) AS FechaEnvio,
    CAST(FechaPrometida AS DATE) AS FechaPrometida,
    CAST(FechaEntrega AS DATE) AS FechaEntrega,

    CAST(ClienteID AS VARCHAR(20)) AS ClienteID,

    CAST(CiudadOrigen AS VARCHAR(100)) AS CiudadOrigen,
    CAST(CiudadDestino AS VARCHAR(100)) AS CiudadDestino,

    CAST(ServicioID AS VARCHAR(20)) AS ServicioID,

    CAST(TransportistaID AS VARCHAR(20)) AS TransportistaID,

    CAST(VehiculoTipo AS VARCHAR(50)) AS VehiculoTipo,

    CAST(PesoKg AS DECIMAL(10,2)) AS PesoKg,
    CAST(DistanciaKm AS DECIMAL(10,2)) AS DistanciaKm,
    CAST(Tarifa AS DECIMAL(12,2)) AS Tarifa,

    CAST(EstadoEntrega AS NVARCHAR(20)) AS EstadoEntrega

FROM dbo.Grupo_C_Logistica;</property>
