                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    CAST(CONVERT(VARCHAR(8), Fecha, 112) AS INT) AS FechaKey,
    Fecha,
    DAY(Fecha) AS Dia,
    MONTH(Fecha) AS Mes,
    CAST(DATENAME(MONTH, Fecha) AS VARCHAR(20)) AS NombreMes,
    DATEPART(QUARTER, Fecha) AS Trimestre,
    YEAR(Fecha) AS Anio
FROM
(
    SELECT CAST(FechaEnvio AS DATE) AS Fecha
    FROM dbo.Grupo_C_Logistica

    UNION

    SELECT CAST(FechaPrometida AS DATE)
    FROM dbo.Grupo_C_Logistica

    UNION

    SELECT CAST(FechaEntrega AS DATE)
    FROM dbo.Grupo_C_Logistica
) AS Fechas
WHERE Fecha IS NOT NULL;</property>
